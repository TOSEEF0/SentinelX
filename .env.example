# ==============================================================================
# SentinelX Configuration Environment File
# Copy to .env and adjust variables as required.
# ==============================================================================

# Server Network Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
DEBUG=False
SENTINELX_SECRET_KEY=sentinelx_audit_secret_key_change_in_prod_9918

# OWASP ZAP Engine Configuration
# Default ZAP daemon port is 8080 (or 8090)
ZAP_URL=http://127.0.0.1:8080
ZAP_API_KEY=sentinelx_zap_internal_api_key_8821
ZAP_TIMEOUT=300
ZAP_POLL_INTERVAL=1.5

# Scanner Safety & Resource Constraints
MAX_SPIDER_PAGES=25
MAX_SPIDER_DEPTH=2
MAX_REDIRECTS=5
REQUEST_TIMEOUT=8
MAX_CONCURRENT_SCANS=2

# SSRF Protection & Safe Local Testing
# Allow loopback testing on approved ports (e.g. 5050) for local demo/QA
ALLOW_LOCAL_TESTING=True

# External AI Advisory Provider
# Options: 'gemma' (Google Gemma 4), 'gemini', 'openai', 'deterministic' (offline)
AI_PROVIDER=gemma
AI_API_KEY=your_gemma_or_gemini_api_key_here
AI_MODEL=gemma-4-26b-a4b-it
